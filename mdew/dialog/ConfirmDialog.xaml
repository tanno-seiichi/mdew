<!-- 確認のダイアログ（はい・いいえ・キャンセル）。ウィンドウを閉じる時の「…は変更されています。閉じる前に保存しますか？」で使う
     （MainWindow.ConfirmClose 参照）。
     見た目は Windows 11 のメッセージボックスに合わせる：白い部分に、左に OS 標準の「？」のアイコン、右にメッセージ。
     下の灰色の帯の右側にボタン（はい(Y)・いいえ(N)・キャンセル）。
     ボタンも Windows 11 の標準のボタンに合わせる（WPF の既定のボタンは見た目が違うため、形を作り直す）：
     白に近い背景・灰色の枠（下側は少し濃い）・角丸。既定のボタン・キーボードの入力先のボタンは青い枠（内側の点線の枠は
     付けない）。マウスを乗せると淡い青、押すとさらに濃い青。ボタンは帯の中央にそろえる。 -->
<Window x:Class="mdew.dialog.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#F0F0F0">
    <Window.Resources>
        <!-- 枠の色（上・左右は #D0D0D0、下の 1px は #BABABA） -->
        <LinearGradientBrush x:Key="NormalBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D0D0D0" Offset="0"/>
            <GradientStop Color="#D0D0D0" Offset="0.92"/>
            <GradientStop Color="#BABABA" Offset="0.96"/>
        </LinearGradientBrush>
        <!-- 既定のボタンの枠（上・左右は #0078D4、下の 1px は #006BBE） -->
        <LinearGradientBrush x:Key="DefaultBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0078D4" Offset="0"/>
            <GradientStop Color="#0078D4" Offset="0.92"/>
            <GradientStop Color="#006BBE" Offset="0.96"/>
        </LinearGradientBrush>

        <Style x:Key="MessageBoxButton" TargetType="Button">
            <Setter Property="MinWidth" Value="73"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="#FDFDFD" BorderBrush="{StaticResource NormalBorder}"
                                    BorderThickness="1" CornerRadius="4"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DefaultBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DefaultBorder}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EEF9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#005499"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 下の帯：ボタン（既定（Enter）は「はい」。Esc・閉じるボタンは「キャンセル」。Y・N キーは PreviewKeyDown で受ける）。
             Y・N の下線は、メッセージボックスと同じく常に表示する -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="22,11,0,11">
            <Button x:Name="m_yesButton" Style="{StaticResource MessageBoxButton}" IsDefault="True" Click="YesClick">
                <TextBlock>はい(<Underline>Y</Underline>)</TextBlock>
            </Button>
            <Button x:Name="m_noButton" Style="{StaticResource MessageBoxButton}" Margin="10,0,0,0" Click="NoClick">
                <TextBlock>いいえ(<Underline>N</Underline>)</TextBlock>
            </Button>
            <Button Style="{StaticResource MessageBoxButton}" Margin="11,0,0,0" IsCancel="True" Content="キャンセル"/>
        </StackPanel>
        <!-- 白い部分：アイコンとメッセージ -->
        <Border Background="#FFFFFF">
            <Grid Margin="21,23,28,23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="m_icon" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="m_message" Grid.Column="1" MaxWidth="440" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="#000000"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
