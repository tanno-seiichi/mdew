<!-- 表を挿入（mde の dialog\TableSizeDialog と同じ見た目・項目）。
     右クリックのメニュー「表を挿入…」から開く（MainWindow.ShowTableSizeDialog 参照）。 -->
<Window x:Class="mdew.dialog.TableSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表を挿入"
        Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="13"
        Background="#FFFFFF">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="表のサイズを指定してください" Margin="0,0,0,16"
                   Foreground="#1C1C1C" FontWeight="Bold"/>

        <TextBlock Text="行数（見出し行を含む）" Style="{StaticResource Caption}"/>
        <TextBox x:Name="m_rowsBox" Text="3" Margin="0,0,0,14" Padding="6,4"/>

        <TextBlock Text="列数" Style="{StaticResource Caption}"/>
        <TextBox x:Name="m_colsBox" Text="3" Margin="0,0,0,22" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="84" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="挿入" Width="84" Height="30" IsDefault="True" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
