<!-- mdew：ダイアログ（WPF のウィンドウ）の部品の見た目。

     閉じる時の確認等の Windows のメッセージボックス（Windows 11 の見た目。app.manifest 参照）と統一感が出るよう、
     WPF の既定の見た目（四角い灰色のボタン等）の代わりに、Windows 11 の標準の部品に近い見た目にする。
       ボタン：白に近い背景・灰色の枠（下側は少し濃い）・角丸 4px。既定のボタン・キーボードの入力先のボタンは青い枠。
               マウスを乗せると淡い青、押すとさらに濃い青（メッセージボックスのボタンと同じ色）
       入力欄：白い背景・灰色の枠（下側は濃い）・角丸 4px。入力中は下側に青い線
       チェックボックス・ラジオボタン：灰色の枠。選ぶと青く塗り、白い印
       Expander（「置換後の文字列」）：左に「›」の印（開くと下向き）
       一覧（ListBox）：灰色の枠・角丸。選んだ項目は淡い青
     矢印キー・Tab キーで移った時の印は、黒い角丸の枠（マウスで操作した時は出ない）。

     使い方：ウィンドウの Resources に、このファイルを読み込む（dialog\FindReplaceWindow.xaml 参照）。
       <ResourceDictionary Source="/mdew;component/dialog/DialogStyles.xaml"/> -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="DlgText" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="DlgDisabledText" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DlgAccent" Color="#0078D4"/>
    <!-- 枠の色（上・左右は #D0D0D0、下の 1px は少し濃い）。ボタンの高さ（約 24px）に合わせた位置で色を変える -->
    <LinearGradientBrush x:Key="DlgButtonBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0D0D0" Offset="0"/>
        <GradientStop Color="#D0D0D0" Offset="0.92"/>
        <GradientStop Color="#BABABA" Offset="0.96"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DlgDefaultButtonBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0078D4" Offset="0"/>
        <GradientStop Color="#0078D4" Offset="0.92"/>
        <GradientStop Color="#006BBE" Offset="0.96"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DlgInputBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0D0D0" Offset="0"/>
        <GradientStop Color="#D0D0D0" Offset="0.93"/>
        <GradientStop Color="#8A8A8A" Offset="0.96"/>
    </LinearGradientBrush>

    <!-- キーボードで移った時の印（部品の外側に、黒い角丸の枠） -->
    <Style x:Key="DlgFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="#1C1C1C" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ボタン -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DlgFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#FDFDFD" BorderBrush="{StaticResource DlgButtonBorder}" BorderThickness="1"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DlgDefaultButtonBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DlgDefaultButtonBorder}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0EEF9"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#005499"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E5E5"/>
                            <Setter Property="Foreground" Value="{StaticResource DlgDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力欄 -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource DlgInputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DlgAccent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <!-- 入力中の印（下側の青い線） -->
                        <Border x:Name="Accent" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                                Background="{StaticResource DlgAccent}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FAFAFA"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="{StaticResource DlgDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- チェックボックス -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DlgFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="#FDFDFD" BorderBrush="#8A8A8A"
                                BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Mark" Data="M 3,7.5 L 6,10.5 L 11.5,4.5" Stroke="White" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#E5E5E5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#0078D4"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#0078D4"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#1A86D9"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#1A86D9"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#C5C5C5"/>
                            <Setter Property="Foreground" Value="{StaticResource DlgDisabledText}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#C5C5C5"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ラジオボタン -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DlgFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Circle" Fill="#FDFDFD" Stroke="#8A8A8A" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="White" Visibility="Hidden"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="#E5E5E5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="#0078D4"/>
                            <Setter TargetName="Circle" Property="Stroke" Value="#0078D4"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Circle" Property="Fill" Value="#1A86D9"/>
                            <Setter TargetName="Circle" Property="Stroke" Value="#1A86D9"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Circle" Property="Stroke" Value="#C5C5C5"/>
                            <Setter Property="Foreground" Value="{StaticResource DlgDisabledText}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Circle" Property="Fill" Value="#C5C5C5"/>
                            <Setter TargetName="Circle" Property="Stroke" Value="#C5C5C5"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander（見出しをクリックすると中身を開く・閉じる。左に「›」の印。開くと下向き） -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" HorizontalAlignment="Left"
                                      Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{StaticResource DlgFocusVisual}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Path x:Name="Chevron" Data="M 3,1 L 7,5 L 3,9" Width="10" Height="10" Margin="2,0,6,0"
                                              Stroke="#5F5F5F" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Stroke" Value="#1C1C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一覧 -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
