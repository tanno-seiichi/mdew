<!-- mdew：ダイアログ（WPF のウィンドウ）の部品の見た目。

     閉じる時の確認等の Windows のメッセージボックス（Windows 11 の見た目。app.manifest 参照）と統一感が出るよう、
     WPF の既定の見た目（四角い灰色のボタン等）の代わりに、Windows 11 の標準の部品に近い見た目にする。
       ボタン：白に近い背景・灰色の枠（下側は少し濃い）・角丸 4px。既定のボタン・キーボードの入力先のボタンは青い枠。
               マウスを乗せると淡い青、押すとさらに濃い青（メッセージボックスのボタンと同じ色）
       入力欄：白い背景・灰色の枠（下側は濃い）・角丸 4px。入力中は下側に青い線
       チェックボックス・ラジオボタン：灰色の枠。選ぶと青く塗り、白い印
       Expander（「置換後の文字列」）：左に「›」の印（開くと下向き）
       一覧（ListBox）：灰色の枠・角丸。選んだ項目は淡い青
     矢印キー・Tab キーで移った時の印は、黒い角丸の枠（マウスで操作した時は出ない）。

     使い方：ウィンドウの Resources に、このファイルを読み込む（dialog\FindReplaceWindow.xaml 参照）。
       <ResourceDictionary Source="/mdew;component/dialog/DialogStyles.xaml"/> -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 色（明るい配色の値）。暗い配色（ダークモード）の時は、Theme.cs がウィンドウの Resources に同じ名前で暗い色を入れて
         置き換える（部品の見た目は、ここの色を DynamicResource で使う）。色を足す・変える時は Theme.cs も直す -->
    <SolidColorBrush x:Key="DlgWindowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DlgText" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="DlgSubText" Color="#555555"/>
    <SolidColorBrush x:Key="DlgStatusText" Color="#666666"/>
    <SolidColorBrush x:Key="DlgDisabledText" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DlgAccent" Color="#0078D4"/>
    <SolidColorBrush x:Key="DlgAccentHover" Color="#1A86D9"/>
    <SolidColorBrush x:Key="DlgOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DlgFocusBorder" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="DlgButtonBackground" Color="#FDFDFD"/>
    <SolidColorBrush x:Key="DlgButtonHoverBackground" Color="#E0EEF9"/>
    <SolidColorBrush x:Key="DlgButtonPressedBackground" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="DlgButtonHoverBorder" Color="#0078D4"/>
    <SolidColorBrush x:Key="DlgButtonPressedBorder" Color="#005499"/>
    <SolidColorBrush x:Key="DlgDisabledBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DlgDisabledBorder" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DlgInputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DlgInputHoverBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="DlgInputFocusBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DlgBoxBackground" Color="#FDFDFD"/>
    <SolidColorBrush x:Key="DlgBoxBorder" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DlgBoxHoverBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="DlgBoxPressedBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DlgBoxDisabled" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="DlgChevron" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="DlgListBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DlgListBorder" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DlgItemHover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="DlgItemSelected" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="DlgInfoBackground" Color="#EEF4FB"/>
    <SolidColorBrush x:Key="DlgInfoBorder" Color="#C8DCF0"/>
    <SolidColorBrush x:Key="DlgInfoLink" Color="#0B62C4"/>
    <!-- スクロールバー（編集画面（WebView2）のスクロールバーと同じ見た目）：溝・つまみ（マウスを乗せた時・押した時）・矢印 -->
    <SolidColorBrush x:Key="DlgScrollTrack" Color="#FCFCFC"/>
    <SolidColorBrush x:Key="DlgScrollThumb" Color="#8B8B8B"/>
    <SolidColorBrush x:Key="DlgScrollThumbHover" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="DlgScrollThumbPressed" Color="#5A5A5A"/>
    <!-- 枠の色（上・左右は #D0D0D0、下の 1px は少し濃い）。ボタンの高さ（約 24px）に合わせた位置で色を変える -->
    <LinearGradientBrush x:Key="DlgButtonBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0D0D0" Offset="0"/>
        <GradientStop Color="#D0D0D0" Offset="0.92"/>
        <GradientStop Color="#BABABA" Offset="0.96"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DlgDefaultButtonBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0078D4" Offset="0"/>
        <GradientStop Color="#0078D4" Offset="0.92"/>
        <GradientStop Color="#006BBE" Offset="0.96"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DlgInputBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0D0D0" Offset="0"/>
        <GradientStop Color="#D0D0D0" Offset="0.93"/>
        <GradientStop Color="#8A8A8A" Offset="0.96"/>
    </LinearGradientBrush>

    <!-- キーボードで移った時の印（部品の外側に、黒い角丸の枠） -->
    <Style x:Key="DlgFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource DlgFocusBorder}" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ボタン -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DlgFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource DlgButtonBackground}" BorderBrush="{DynamicResource DlgButtonBorder}" BorderThickness="1"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DlgDefaultButtonBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DlgDefaultButtonBorder}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgButtonHoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DlgButtonHoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgButtonPressedBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DlgButtonPressedBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgDisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DlgDisabledBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DlgDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力欄 -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
        <Setter Property="Background" Value="{DynamicResource DlgInputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DlgInputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource DlgAccent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <!-- 入力中の印（下側の青い線） -->
                        <Border x:Name="Accent" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                                Background="{DynamicResource DlgAccent}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgInputHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgInputFocusBackground}"/>
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgDisabledBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DlgDisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- チェックボックス -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DlgFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="{DynamicResource DlgBoxBackground}" BorderBrush="{DynamicResource DlgBoxBorder}"
                                BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Mark" Data="M 3,7.5 L 6,10.5 L 11.5,4.5" Stroke="{DynamicResource DlgOnAccent}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DlgBoxHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DlgBoxPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DlgAccent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DlgAccentHover}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DlgAccentHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DlgBoxDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DlgDisabledText}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DlgBoxDisabled}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ラジオボタン -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DlgFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Circle" Fill="{DynamicResource DlgBoxBackground}" Stroke="{DynamicResource DlgBoxBorder}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource DlgOnAccent}" Visibility="Hidden"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource DlgBoxHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource DlgBoxPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource DlgAccent}"/>
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource DlgAccent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource DlgAccentHover}"/>
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource DlgAccentHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource DlgBoxDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DlgDisabledText}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource DlgBoxDisabled}"/>
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource DlgBoxDisabled}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander（見出しをクリックすると中身を開く・閉じる。左に「›」の印。開くと下向き） -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" HorizontalAlignment="Left"
                                      Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{StaticResource DlgFocusVisual}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Path x:Name="Chevron" Data="M 3,1 L 7,5 L 3,9" Width="10" Height="10" Margin="2,0,6,0"
                                              Stroke="{DynamicResource DlgChevron}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource DlgText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- スクロールバー（一覧等）。編集画面（WebView2・Chromium）の Windows 11 風のスクロールバーと同じ見た目にする：
         幅 15px の淡い溝に、幅 9px の丸いつまみ。両端に小さな三角の矢印（クリックで少しずつ動く）。
         マウスを乗せる・押すと、つまみ・矢印が濃くなる -->
    <Style x:Key="DlgScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource DlgScrollThumb}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <!-- 矢印の形は、RepeatButton の Content に書いた図形（Binding で Geometry に変換される） -->
                        <Path x:Name="Arrow" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource DlgScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource DlgScrollThumbPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 溝（つまみの前後をクリックすると1画面ずつ動く。見た目は透明） -->
    <Style x:Key="DlgScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DlgScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource DlgScrollThumb}" CornerRadius="4.5" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgScrollThumbPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource DlgScrollTrack}"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="MinWidth" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- 縦のスクロールバー -->
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="15"/>
                        </Grid.RowDefinitions>
                        <RepeatButton Grid.Row="0" Style="{StaticResource DlgScrollArrow}" Command="ScrollBar.LineUpCommand"
                                      Content="M 0,5 L 4,0 L 8,5 Z"/>
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DlgScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DlgScrollThumbStyle}" Width="9" Margin="0,1"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DlgScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <RepeatButton Grid.Row="2" Style="{StaticResource DlgScrollArrow}" Command="ScrollBar.LineDownCommand"
                                      Content="M 0,0 L 8,0 L 4,5 Z"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 横のスクロールバー -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="MinHeight" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                </Grid.ColumnDefinitions>
                                <RepeatButton Grid.Column="0" Style="{StaticResource DlgScrollArrow}" Command="ScrollBar.LineLeftCommand"
                                              Content="M 5,0 L 0,4 L 5,8 Z"/>
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource DlgScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DlgScrollThumbStyle}" Height="9" Margin="1,0"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource DlgScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Column="2" Style="{StaticResource DlgScrollArrow}" Command="ScrollBar.LineRightCommand"
                                              Content="M 0,0 L 5,4 L 0,8 Z"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- スクロールする領域（縦・横のスクロールバーが両方出た時の、右下の角も溝と同じ色にする） -->
    <Style x:Key="DlgScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource DlgScrollTrack}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一覧 -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
        <Setter Property="Background" Value="{DynamicResource DlgListBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DlgListBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" Style="{StaticResource DlgScrollViewer}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgItemHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DlgItemSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
