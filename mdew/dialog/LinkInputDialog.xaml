<!-- リンク先の URL の入力（mde の dialog\LinkInputDialog と同じ見た目・項目）。
     右クリックのメニュー「リンクにする…」から開く（MainWindow.ShowLinkDialog 参照）。 -->
<Window x:Class="mdew.dialog.LinkInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リンク"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12"
        Background="#FFFFFF">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 部品（ボタン・入力欄）の見た目。検索と置換と同じ Windows 11 風のもの（dialog\DialogStyles.xaml） -->
            <ResourceDictionary Source="/mdew;component/dialog/DialogStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="リンク先のURLを入力してください" Margin="0,0,0,16"
                   Foreground="#1C1C1C" FontWeight="Bold"/>

        <TextBlock Text="URL" Margin="0,0,0,4" Foreground="#555555"/>
        <TextBox x:Name="m_urlBox" Margin="0,0,0,14" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" MinWidth="84" IsDefault="True" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
