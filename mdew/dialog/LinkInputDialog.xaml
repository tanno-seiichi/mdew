<!-- リンク先の URL の入力（mde の dialog\LinkInputDialog と同じ見た目・項目）。
     右クリックのメニュー「リンクにする…」から開く（MainWindow.ShowLinkDialog 参照）。 -->
<Window x:Class="mdew.dialog.LinkInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リンク"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="13"
        Background="#FFFFFF">
    <StackPanel Margin="22">
        <TextBlock Text="リンク先のURLを入力してください" Margin="0,0,0,16"
                   Foreground="#1C1C1C" FontWeight="Bold"/>

        <TextBlock Text="URL" Margin="0,0,0,4" Foreground="#555555" FontSize="12"/>
        <TextBox x:Name="m_urlBox" Margin="0,0,0,14" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="84" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="84" Height="30" IsDefault="True" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
