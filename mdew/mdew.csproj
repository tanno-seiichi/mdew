<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>mdew</AssemblyName>
    <RootNamespace>mdew</RootNamespace>
    <!-- アプリ名（タイトルバー等に表示する。Program.AppName 参照）・作成者・著作権の表示。
         エクスプローラーで exe のプロパティ→「詳細」に表示される -->
    <AssemblyTitle>mdew</AssemblyTitle>
    <Product>mdew</Product>
    <Authors></Authors>
    <Company></Company>
    <Copyright>Copyright © 2026 tanno-seiichi</Copyright>
    <!-- アプリのバージョン（タイトルバーに表示する。Program.Version 参照）。
         4桁で書くと、ファイルバージョンと製品バージョンが同じ表示（0.0.1.0）になる -->
    <Version>0.1.2.0</Version>
    <!-- バージョンの表示に、ソース管理のリビジョン（+xxxx）を付けない -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- アプリのアイコン -->
    <ApplicationIcon>images\mde.ico</ApplicationIcon>
    <!-- アプリのマニフェスト（app.manifest）。コモンコントロール 6 を使う設定で、Windows のメッセージボックス
         （MessageBox.Show）が、今の Windows の見た目（角丸のボタン等）で表示されるようにする -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 64bit（x64）の Windows だけを対象にする。RuntimeIdentifier を指定すると、WebView2 の
         WebView2Loader.dll（ネイティブ DLL）は x64 用だけが実行フォルダの直下にコピーされる
         （指定しないと runtimes\win-x64・win-x86・win-arm64 の３つがコピーされる）。
         SelfContained=false：.NET ランタイムは同梱しない（別途インストールしたものを使う）。
         AppendRuntimeIdentifierToOutputPath=false：出力先を bin\Release\net10.0-windows のままにする
         （msi\File.wxs はこのフォルダのファイルを同梱する） -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- 動作の記録：TraceLog を true にしてビルドすると（コンパイルスイッチ TRACE_LOG）、%LocalAppData%\mdew\error.log に
       起動・終了と、起動にかかった時間（Program.cs の StartupTiming）を書く。既定は false（エラーが起きた時だけ書く。
       エラーが無ければ error.log は作られない）。コマンドでは dotnet build -p:TraceLog=true でも有効にできる -->
  <PropertyGroup>
    <TraceLog Condition="'$(TraceLog)' == ''">false</TraceLog>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TraceLog)' == 'true'">
    <DefineConstants>$(DefineConstants);TRACE_LOG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);TRACE_LOG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet のパッケージを追加・更新した時は、インストーラー側の msi\THIRD-PARTY-NOTICES.txt
         （バージョン・ライセンス文）と msi\File.wxs（同梱するファイル）も直す -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- WebView2 の WinForms 用の DLL（Microsoft.Web.WebView2.WinForms.dll）は使わないので、参照・実行フォルダへのコピー・
       mdew.deps.json から外す。WebView2 のパッケージは、WPF 用・WinForms 用の DLL をどちらも参照に加えるため、
       使っていなくても実行フォルダにコピーされ、mdew.deps.json（起動時に .NET が読む依存関係の一覧）にも載る。
       mdew.deps.json に載ったままファイルだけ無いと起動できなくなるので、インストーラーで外すだけでは足りない -->
  <Target Name="RemoveWebView2WinForms" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- 画面側（HTML・JavaScript・CSS）は、ビルドせずにそのまま実行フォルダの web へコピーする -->
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- ヘルプ→「Readmeを開く」（F1）用に、リポジトリ直下の README.md を実行フォルダへコピーする
         （Program.cs の OpenReadme は、この実行フォルダ側の README.md を開く。msi\File.wxs も、これを同梱する） -->
    <Content Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- バージョン情報のウィンドウ（dialog\AboutWindow）に表示するアイコン。exe の中に埋め込む -->
    <None Remove="images\mde.png" />
    <Resource Include="images\mde.png" />
  </ItemGroup>

</Project>
