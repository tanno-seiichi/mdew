<!-- mdew：メニューバーのメニュー（Program.cs の ShowWebMenu）の見た目。

     メニューバーのメニューは、ウィンドウの外まで広がって表示できるよう（長いパスの「最近使ったファイル」等を省略しないよう）、
     ホスト側の WPF のメニュー（ContextMenu）で開く。見た目は、右クリックのメニュー（HTML。web\app.css の .md-menu）と
     そろえる：白い背景・灰色の枠（角丸 6px）・影、文字は Yu Gothic UI の 13px、項目の余白は上下 5px・左 6px・右 16px、
     左にチェックの印の欄（18px、青の ✓）、右にショートカット（灰色の 12px）・サブメニューの印（▸）、マウスを乗せた・
     矢印キーで選んだ項目は淡い青、使えない項目は灰色、区切り線は淡い灰色、見出しは灰色の 12px。

     影を描く分、メニューの外側に透明な余白（12px）を取る。開く位置は、この余白の分ずらす（Program.cs の WEB_MENU_SHADOW）。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WebMenuText" Color="#333333"/>
    <SolidColorBrush x:Key="WebMenuBorder" Color="#C8CCD1"/>
    <SolidColorBrush x:Key="WebMenuHighlight" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="WebMenuCheck" Color="#0B62C4"/>
    <SolidColorBrush x:Key="WebMenuSub" Color="#888888"/>
    <SolidColorBrush x:Key="WebMenuDisabled" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="WebMenuDisabledSub" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="WebMenuSeparatorLine" Color="#E3E5E8"/>
    <FontFamily x:Key="WebMenuFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>

    <!-- メニューの枠（影・白い背景・灰色の枠・角丸）。メニューバーのメニューと、サブメニューで使う -->
    <ControlTemplate x:Key="WebMenuPanel" TargetType="ContentControl">
        <Grid Margin="12">
            <!-- 影（枠と同じ形の要素に付ける。中身に付けると文字がぼやけるため） -->
            <Border Background="White" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.15"/>
                </Border.Effect>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource WebMenuBorder}" BorderThickness="1" CornerRadius="6"
                    Padding="0,4" MinWidth="160">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentPresenter/>
                </ScrollViewer>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- メニューバーのメニュー -->
    <Style x:Key="WebMenu" TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource WebMenuFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource WebMenuText}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <ContentControl Template="{StaticResource WebMenuPanel}" Focusable="False">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 項目（サブメニューを持たないもの） -->
    <ControlTemplate x:Key="WebMenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="6,5,16,5" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource WebMenuCheck}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                           Foreground="{StaticResource WebMenuSub}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WebMenuHighlight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource WebMenuDisabled}"/>
                <Setter TargetName="Gesture" Property="Foreground" Value="{StaticResource WebMenuDisabledSub}"/>
                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- サブメニューを持つ項目（右側に ▸。サブメニューは項目の右に、親のメニューと 2px 重ねて開く。右に収まらなければ左に開く） -->
    <ControlTemplate x:Key="WebMenuSubmenuTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="6,5,16,5" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource WebMenuCheck}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="Arrow" Grid.Column="2" Text="▸" Margin="28,0,0,0" Foreground="{StaticResource WebMenuSub}"
                           FontSize="12" VerticalAlignment="Center"/>
                <!-- 開く位置（右クリックのメニューと同じく、サブメニューの枠を、親のメニューの枠と 2px 重ね、項目の上端の 5px 上に置く）。
                     基準のこの Grid は、項目の右の余白（16px）・上の余白（5px）の内側。サブメニューの外側には影の余白（12px）がある。
                     横：16（右の余白）+ 1（親の枠）- 2（重ね）- 12（影の余白）= 3、縦：-5（上の余白）- 5 - 12（影の余白）= -22 -->
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="3" VerticalOffset="-22"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <ContentControl Template="{StaticResource WebMenuPanel}" Focusable="False">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Cycle"/>
                    </ContentControl>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WebMenuHighlight}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WebMenuHighlight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource WebMenuDisabled}"/>
                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource WebMenuDisabledSub}"/>
                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="WebMenuItem" TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource WebMenuText}"/>
        <Setter Property="Template" Value="{StaticResource WebMenuItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource WebMenuSubmenuTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 選べない見出し（下の項目のまとまりの名前。「表示倍率：100%」等） -->
    <Style x:Key="WebMenuHeading" TargetType="MenuItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <TextBlock Text="{TemplateBinding Header}" Padding="10,4,16,2" FontSize="12"
                               Foreground="{StaticResource WebMenuSub}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 区切り線 -->
    <Style x:Key="WebMenuSeparator" TargetType="Separator">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,4" Background="{StaticResource WebMenuSeparatorLine}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
